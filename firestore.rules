rules_version = '2';
// O cliente NUNCA lê/escreve o Firestore direto: tudo passa pelas Cloud
// Functions (admin SDK, que ignora estas rules). Então negamos tudo pro cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
