# Copie para .env e preencha. NUNCA commitar o .env real.

# Self-host pessoal
SIGECAD_TOKEN=
NOTIFY_EMAIL=

# KEK mestra (base64, 32 bytes). Gere UMA vez e mantenha ESTÁVEL:
#   ./.venv/bin/python crypto.py --genkey
# Em produção: guardar em KMS/Secrets Manager, não em arquivo.
MASTER_KEY=

# Opcional. No Docker Compose já aponta para o volume persistente.
# SIGECAD_DB_PATH=/caminho/privado/data.db

# Resend (https://resend.com) — para enviar email de verdade.
RESEND_API_KEY=
RESEND_FROM=Notas UFGD <notas@seudominio.com>
